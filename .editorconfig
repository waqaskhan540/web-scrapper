root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.CA2007.severity = none

[*.{json,yml,yaml,props,csproj,md}]
indent_size = 2

# Test projects only. Underscore-separated test names (Thing_DoesX_WhenY) are the standard
# .NET testing convention and are the clearest documentation a failing test can carry, so
# CA1707 is disabled here and nowhere else. Constitution T-2 requires suppressions to be
# narrowly scoped and justified; this scope is tests/ alone.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# EF Core-generated migrations. These files are regenerated by `dotnet ef`, so hand-editing
# them to satisfy style and performance analyzers would be undone on the next scaffold. Scoped
# to the generated directory only — the hand-written DbContext next door is still fully analyzed.
# Constitution T-2 requires suppressions to be narrow and justified; this is generated code.
[**/Storage/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_analyzer_diagnostic.category-Style.severity = none
